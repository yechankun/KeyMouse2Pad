;
; ConverterVhf.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=ConverterVhf.cat
DriverVer=05/12/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=ConverterVhf_Install, Root\KeyMouse2Pad

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
ConverterVhf.sys=1

[DestinationDirs]
DefaultDestDir=13

[ConverterVhf_Install.NT]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
ConverterVhf.sys

[ConverterVhf_Install.NT.Services]
AddService=ConverterVhf,0x00000002,ConverterVhf_Service

[ConverterVhf_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\ConverterVhf.sys

[ConverterVhf_Install.NT.Wdf]
KmdfService=ConverterVhf, ConverterVhf_WdfSection

[ConverterVhf_WdfSection]
KmdfLibraryVersion=1.33

[Strings]
ManufacturerName="KeyMouse2Pad"
DiskName="KeyMouse2Pad VHF Driver Disk"
DeviceName="KeyMouse2Pad HID Gamepad"
ServiceName="KeyMouse2Pad VHF Driver"
